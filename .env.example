# ----------------------------------------------------------------------------
# NetForge — environment variables
# Copy this file to .env and fill in the values. .env is NOT version-controlled.
#
# Defaults below are tuned for the DEV stack (docker-compose.dev.yml). For
# PRODUCTION (docker-compose.yml at repo root), at minimum you must:
#   - Set AUTH_PROVIDER to "oidc" or "github" (NEVER "dev" in prod).
#     (SESSION_COOKIE_SECURE is already forced to "true" by the prod compose,
#      which is what makes AUTH_PROVIDER=dev refuse to start there.)
#   - Set POSTGRES_PASSWORD and SESSION_SIGNING_KEY to actual secrets
#     (`openssl rand -hex 32` is fine for both).
#   - Set BOOTSTRAP_ADMIN_EMAIL to a real address — the first matching
#     login is auto-promoted to admin.
#   - Fill in the credentials block for the provider you picked.
# ----------------------------------------------------------------------------

# Pin a specific NetForge release for the prod compose (image-pull path).
# Leave unset and docker-compose.yml defaults to the version it shipped with
# (currently v0.1.0) — NOT "latest". Set this explicitly once you're past
# first setup so `docker compose pull` never silently upgrades production.
# NETFORGE_VERSION=v1.0.0

# Public URL used to build OAuth / OIDC redirect URIs.
# Dev default: the Vite dev server, which proxies /api/* to the backend.
# Must stay loopback while AUTH_PROVIDER=dev — the dev provider refuses to
# start otherwise (backend/app/auth/dev.py). In production set this to the
# real HTTPS origin, e.g. https://netforge.example.local
PUBLIC_URL=http://localhost:5173

# PostgreSQL (used by the postgres container AND by the backend)
POSTGRES_DB=netforge
POSTGRES_USER=netforge
POSTGRES_PASSWORD=change-me-generate-a-32-char-random

# Host port the dev compose publishes Postgres on (loopback only). Bump this
# if you already run Postgres on the host — 5432 is taken and the bind fails
# with "ports are not available". Unused by the prod compose, which publishes
# no Postgres port at all.
POSTGRES_HOST_PORT=5432

# DATABASE_URL consumed by the backend when you run it OUTSIDE Docker (replace
# "postgres" with "localhost"). Both compose files build this string themselves
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, so a value set here has
# no effect on the containers.
DATABASE_URL=postgresql+asyncpg://netforge:change-me-generate-a-32-char-random@postgres:5432/netforge

# ----------------------------------------------------------------------------
# Authentication
#
# Pick one of: github, oidc, dev
#   - dev   : DEV ONLY. Bypasses OAuth entirely and signs anyone in as the
#             account below (admin role). Refuses to start when
#             SESSION_COOKIE_SECURE=true. Never use in production.
#   - github: GitHub OAuth — needs GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.
#   - oidc  : generic OIDC — point OIDC_ISSUER_URL at the IdP (Entra ID,
#             Keycloak, Authentik, Google Workspace, GitLab, ...).
# ----------------------------------------------------------------------------
AUTH_PROVIDER=dev

# Same choice, but for the SPA's login screen (which button it renders).
# Read at build/dev-server time by frontend/src/views/LoginView.vue; keep it in
# sync with AUTH_PROVIDER above. Only the dev compose passes it — the prod
# frontend image bakes it in at build time (see frontend/.env.example).
VITE_AUTH_PROVIDER=dev

# --- Dev provider (ignored unless AUTH_PROVIDER=dev) ---
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_NAME=Dev Admin

# --- GitHub OAuth (https://github.com/settings/developers) ---
# Authorization callback URL to register on GitHub: <PUBLIC_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Generic OIDC (Entra ID, Keycloak, Authentik, Google Workspace, GitLab, ...) ---
# Examples:
#   Entra ID:    https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:    https://<host>/realms/<realm>
#   Authentik:   https://<host>/application/o/<slug>/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
# SECURITY: keep this true. OIDC encodes "the IdP verified this email" in the
# boolean `email_verified` claim. On a permissive IdP (multi-tenant Entra,
# public Google, self-service Keycloak realm) an attacker can register an
# account with an arbitrary email and, combined with JIT user creation +
# BOOTSTRAP_ADMIN_EMAIL, JIT-promote themselves to admin. Set to false ONLY
# if your IdP does not emit the claim AND you trust every email it asserts
# (e.g. a single-tenant corporate Entra).
OIDC_REQUIRE_EMAIL_VERIFIED=true

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
# Signs the short-lived Starlette session that holds the OAuth state.
# Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=change-me

# Cookie name holding the long-lived session id. Rarely needs changing —
# override only if the default collides with another app on the same domain.
SESSION_COOKIE_NAME=netforge_session

# Leave false for local HTTP dev. In production the prod compose hardcodes
# "true", so this value is only consulted when you run the backend outside
# Docker over HTTPS.
SESSION_COOKIE_SECURE=false

# The first email to log in matching this is promoted to admin (optional).
# Leave empty to fall back to "first user to ever log in becomes admin".
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Session lifetime in seconds. 8h sliding renewal by default.
SESSION_MAX_AGE_SECONDS=28800

# ----------------------------------------------------------------------------
# Redis / caching
# ----------------------------------------------------------------------------
# Redis is what makes the UI feel fast: it caches the per-request session
# lookup and the expensive assembled reads (topology graph, global search,
# subnet tree, dashboard capacity widget). It can also hold the rate-limit
# counters — see RATE_LIMIT_STORE below.
#
# Entirely optional. Set REDIS_URL= (empty) and every consumer falls back to
# Postgres; the stack behaves exactly as it did before Redis was added. The
# bundled docker-compose.yml ships a `redis` service and points this at it, so
# the default production stack has the cache on. Emptying REDIS_URL stops the
# backend using Redis but does not stop the container starting — to drop the
# service entirely, delete the `redis:` block and the backend's `depends_on:
# redis` entry from your compose file.
#
# Format: redis://[:password@]host:port/db  (rediss:// for TLS)
# The `redis` hostname resolves on the compose network only — running the
# backend directly on the host means pointing this at localhost, same caveat as
# DATABASE_URL above.
# If you set REDIS_PASSWORD below, compose folds it into this URL for you;
# only override REDIS_URL by hand when pointing at a Redis you run yourself.
REDIS_URL=redis://redis:6379/0

# Optional AUTH password for the bundled redis service. Empty = no password,
# which is safe here because the service publishes no host port and is only
# reachable on the compose network (same trust boundary as postgres). Set it
# if your policy requires auth on every datastore.
REDIS_PASSWORD=

# Memory ceiling for the bundled redis service, with `allkeys-lru` eviction.
# 256mb is far more than this workload needs (a large topology payload is a
# few hundred KB). NOTE: if you run AI_ENABLED=true *and* RATE_LIMIT_STORE=redis,
# the per-user AI quota lives in Redis — under memory pressure LRU can evict a
# counter and hand that user a fresh window early. Keep this generous, or leave
# RATE_LIMIT_STORE=database so the quota sits in Postgres.
REDIS_MAXMEMORY=256mb

# Host port for the dev stack's redis (docker-compose.dev.yml), bound to
# loopback. Change it if something already owns 6379 on your machine.
REDIS_HOST_PORT=6379

# Caps both connect and command time, in seconds. Deliberately sub-second: a
# cache call sits on the request's critical path and falling back to Postgres
# is always available, so waiting on a wedged Redis is never the better trade.
REDIS_TIMEOUT_SECONDS=0.5

# Prefixes every key. Change it to run two NetForge deployments (staging and
# production, say) against one Redis without them sharing entries.
CACHE_KEY_PREFIX=netforge

# --- Session cache ---
# Caches the (session cookie -> user) resolution that every authenticated
# request otherwise costs two SELECTs to rebuild.
#
# SECURITY: NetForge keeps sessions in a table rather than in a JWT precisely
# so revocation is immediate. Caching that lookup puts a window in front of it.
# Logout evicts its own entry, so the normal path stays instant; the TTL is
# what bounds any path that is NOT wired to evict — most notably an admin
# editing `users.role` directly in the database. Keep the TTL small. Set
# CACHE_SESSIONS_ENABLED=false to keep the read cache but always resolve the
# principal against Postgres.
CACHE_SESSIONS_ENABLED=true
CACHE_SESSION_TTL_SECONDS=30

# --- Read cache ---
# Caches /api/topology, /api/search, /api/subnets/tree and
# /api/subnets/capacity-overview. Staleness is NOT a concern here: the cache
# key embeds a fingerprint of the inventory tables, so any write changes the
# key and no reader can be served a pre-write payload. The TTL only bounds how
# long superseded entries linger in Redis.
CACHE_READS_ENABLED=true
CACHE_READ_TTL_SECONDS=300

# ----------------------------------------------------------------------------
# Rate limiting (writes only — reads are never throttled)
# ----------------------------------------------------------------------------
# Per-IP cap on POST/PUT/PATCH/DELETE within RATE_LIMIT_WINDOW_SECONDS.
# Defaults: 60 writes per 60 seconds. Raise if you have legitimate batch
# writers; lower if the deployment is internet-facing.
RATE_LIMIT_WRITES_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60

# Where the counters live — applies to BOTH limiters (writes per IP and AI
# calls per user, AI_RATE_LIMIT_CALLS below).
#   database (default) — the `rate_limit_counters` table. Every uvicorn
#                        worker and every replica shares one budget, and the
#                        AI quota survives a restart. Costs one extra
#                        statement per write request.
#   redis              — same shared budget via INCR + EXPIRE, off the DB's
#                        write path. Requires REDIS_URL; the backend refuses
#                        to start without it. Read the REDIS_MAXMEMORY note
#                        above before combining this with AI_ENABLED=true.
#   memory             — legacy per-process sliding window. No extra DB
#                        traffic, but the effective cap becomes
#                        (workers x limit) and restarts reset AI quotas.
#                        Only correct on a single-worker, single-replica
#                        deployment.
RATE_LIMIT_STORE=database

# Trusted reverse-proxy networks (comma-separated CIDRs). The backend only
# honours the `X-Real-IP` header when the immediate TCP peer matches one of
# these — otherwise anyone can spoof X-Real-IP to bypass the per-IP rate
# limit and to poison audit_log.ip_address / sessions.ip_address.
# SECURITY: keep this as narrow as your topology allows. The default covers
# loopback (single uvicorn behind nginx on the same host) and the standard
# docker-compose bridge subnet (172.16.0.0/12) — that whole /12 is wide, but
# it's what a bare `docker compose up` actually assigns. If you add an
# external load balancer or sidecar proxy in front of nginx, add its
# subnet/IP here rather than widening this further than necessary.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ----------------------------------------------------------------------------
# Outbound webhooks
# ----------------------------------------------------------------------------
# Webhook URLs are admin-supplied. By default the backend refuses to dispatch
# to private / loopback / cloud-metadata IPs (SSRF protection — see
# backend/app/utils/ssrf.py).
# SECURITY: leave this false. Flipping it to true disables that protection
# entirely, letting an admin-configured webhook target 127.0.0.1, the docker
# bridge, or the cloud metadata endpoint (169.254.169.254) — only do this if
# the backend genuinely needs to hit a private target (a relay on the same
# docker network, a dev box on localhost).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Optional shared secret used to HMAC-sign AI scheduler webhook payloads with
# an X-Netforge-Signature header (sha256=<hmac> over the exact body bytes),
# letting the receiver authenticate that a notification really came from
# NetForge. Empty (the default) sends payloads unsigned.
# Generate with: openssl rand -hex 32
AI_WEBHOOK_SIGNING_SECRET=

# ----------------------------------------------------------------------------
# CSV import
# ----------------------------------------------------------------------------
# Hard cap on data rows accepted per CSV (header row excluded). The upload
# size cap above (50 MiB total across a bulk import) bounds the *weight* of
# a file but not its row count — a file of very short rows can stay small
# in bytes while still producing hundreds of thousands of rows to resolve
# and flush. Raise only if your inventory legitimately needs bigger imports.
CSV_IMPORT_MAX_ROWS=50000

# ----------------------------------------------------------------------------
# Audit log retention
# ----------------------------------------------------------------------------
# Days after which audit_log rows are purged (mirrors the existing rolling
# windows on webhook_deliveries and ai_run_logs). 0 (default) disables the
# purge — unlimited retention, the safe default for an audit trail. Set to
# your compliance/retention policy in days (e.g. 365) to cap disk growth.
AUDIT_LOG_RETENTION_DAYS=0

# Backend log level (debug, info, warning, error)
LOG_LEVEL=info
# Log output format: "text" (human-readable, default) or "json" (one JSON
# object per line for log aggregators — carries request_id + structured fields).
LOG_FORMAT=text

# Allowed CORS origins (dev only). In production leave empty: everything goes through the nginx reverse proxy.
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# AI integration (provider-agnostic). Off by default — flip AI_ENABLED to
# true after picking a provider and dropping in its API key.
#
# Features unlocked when enabled (admin-only):
#   - Suggest links scan on the Topology page
#   - Infra advisor (SPOF / capacity / security / segmentation insights)
#   - Natural-language Q&A on the inventory
#
# Privacy note: enabling this sends your inventory snapshot (sites, rooms,
# switches, ports, vlans, subnets, devices, links) to the provider's API.
# Keep AI_ENABLED=false if that's not acceptable for your deployment.
# ----------------------------------------------------------------------------
AI_ENABLED=false
# One of: anthropic | openai | gemini. All three are implemented; switching
# is a config change, no code modification needed.
AI_PROVIDER=anthropic
# Optional model override. Defaults per provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o
#   gemini    → gemini-2.5-pro
AI_MODEL=
# Provider API keys — only the one matching AI_PROVIDER needs a value.
#   anthropic: https://console.anthropic.com/settings/keys
#   openai:    https://platform.openai.com/api-keys
#   gemini:    https://aistudio.google.com/app/apikey
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# Per-user budget. Defaults: 20 calls per hour, generous for interactive
# use and tight enough to stop a runaway script from burning tokens.
AI_RATE_LIMIT_CALLS=20
AI_RATE_WINDOW_SECONDS=3600
AI_MAX_OUTPUT_TOKENS=2048
# Granular feature toggles — all default to true, gated by AI_ENABLED.
# Flip individually if your compliance or risk review only signs off on a
# subset of the AI surface.
#   AI_DRAFTS_ENABLED      → NL-to-action drafts (`/api/ai/drafts/...`).
#                            Disable to keep the LLM strictly read-only.
#   AI_SCHEDULER_ENABLED   → background loop that auto-runs the advisor /
#                            suggest-links scan on a schedule + webhook.
#                            Disable to keep manual buttons but never auto-fire.
AI_DRAFTS_ENABLED=true
AI_SCHEDULER_ENABLED=true
