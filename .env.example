# ----------------------------------------------------------------------------
# NetForge — environment variables
# Copy this file to .env and fill in the values. .env is NOT version-controlled.
#
# Defaults below are tuned for the DEV stack (docker-compose.dev.yml). For
# PRODUCTION (docker-compose.yml at repo root), at minimum you must:
#   - Set AUTH_PROVIDER to "oidc" or "github" (NEVER "dev" in prod).
#   - Set SESSION_COOKIE_SECURE=true.
#   - Set POSTGRES_PASSWORD and SESSION_SIGNING_KEY to actual secrets
#     (`openssl rand -hex 32` is fine for both).
#   - Set BOOTSTRAP_ADMIN_EMAIL to a real address — the first matching
#     login is auto-promoted to admin.
#   - Fill in the credentials block for the provider you picked.
# ----------------------------------------------------------------------------

# Pin a specific NetForge release for the prod compose (image-pull path).
# Leave unset to track the latest build of the main branch.
# NETFORGE_VERSION=v1.0.0

# Public URL used to build OAuth / OIDC redirect URIs
PUBLIC_URL=https://netforge.example.local

# PostgreSQL (used by the postgres container AND by the backend)
POSTGRES_DB=netforge
POSTGRES_USER=netforge
POSTGRES_PASSWORD=change-me-generate-a-32-char-random

# DATABASE_URL consumed by the backend. For local dev outside Docker, replace "postgres" with "localhost".
DATABASE_URL=postgresql+asyncpg://netforge:change-me-generate-a-32-char-random@postgres:5432/netforge

# ----------------------------------------------------------------------------
# Authentication
#
# Pick one of: github, oidc, dev
#   - dev   : DEV ONLY. Bypasses OAuth entirely and signs anyone in as the
#             account below (admin role). Refuses to start when
#             SESSION_COOKIE_SECURE=true. Never use in production.
#   - github: GitHub OAuth — needs GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.
#   - oidc  : generic OIDC — point OIDC_ISSUER_URL at the IdP (Entra ID,
#             Keycloak, Authentik, Google Workspace, GitLab, ...).
# ----------------------------------------------------------------------------
AUTH_PROVIDER=dev

# --- Dev provider (ignored unless AUTH_PROVIDER=dev) ---
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_NAME=Dev Admin

# --- GitHub OAuth (https://github.com/settings/developers) ---
# Authorization callback URL to register on GitHub: <PUBLIC_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Generic OIDC (Entra ID, Keycloak, Authentik, Google Workspace, GitLab, ...) ---
# Examples:
#   Entra ID:    https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:    https://<host>/realms/<realm>
#   Authentik:   https://<host>/application/o/<slug>/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
# Signs the short-lived Starlette session that holds the OAuth state.
# Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=change-me

# Set to true in production (HTTPS). Leave false for local HTTP dev.
SESSION_COOKIE_SECURE=false

# The first email to log in matching this is promoted to admin (optional).
# Leave empty to fall back to "first user to ever log in becomes admin".
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Session lifetime in seconds. 8h sliding renewal by default.
SESSION_MAX_AGE_SECONDS=28800

# ----------------------------------------------------------------------------
# Rate limiting (writes only — reads are never throttled)
# ----------------------------------------------------------------------------
# Per-IP cap on POST/PUT/PATCH/DELETE within RATE_LIMIT_WINDOW_SECONDS.
# Defaults: 60 writes per 60 seconds. Raise if you have legitimate batch
# writers; lower if the deployment is internet-facing.
RATE_LIMIT_WRITES_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60

# Backend log level (debug, info, warning, error)
LOG_LEVEL=info

# Allowed CORS origins (dev only). In production leave empty: everything goes through the nginx reverse proxy.
CORS_ORIGINS=http://localhost:5173
