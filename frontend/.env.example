# NetForge frontend — copy to .env.local for local dev (.env.local is git-ignored).

# Backend URL the Vite dev server proxies to. The default works with the
# docker-compose.dev.yml backend container exposed on localhost:8000.
VITE_BACKEND_URL=http://localhost:8000

# Which auth provider the backend is configured for — only used to label the
# "Sign in with X" button on the login page. Must match the backend's
# AUTH_PROVIDER setting. One of: github | oidc | dev | default
# (see frontend/src/env.d.ts). Defaults to "dev" because that is also the
# backend's default in docker-compose.dev.yml; switch to github / oidc once
# you point the backend at a real IdP.
VITE_AUTH_PROVIDER=dev

# Optional version string shown in the login footer.
VITE_APP_VERSION=0.1.0
